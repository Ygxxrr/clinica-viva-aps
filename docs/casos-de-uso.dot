digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.5, nodesep=0.35, ranksep=1.2, splines=polyline, fontname="Arial", fontsize=22, label="Clínica Silva · Casos de uso", labelloc=t];
node [fontname="Arial", fontsize=12, color="#75A68E", style=filled, fillcolor="#F0F8F3"];
edge [fontname="Arial", fontsize=10, color="#789787", fontcolor="#4E7860", arrowsize=0.7];
Reception [shape=box, fillcolor="#FFFFFF", label="«ator»\nRecepção"];
Doctor [shape=box, fillcolor="#FFFFFF", label="«ator»\nMédico"];
Finance [shape=box, fillcolor="#FFFFFF", label="«ator»\nFinanceiro"];
Admin [shape=box, fillcolor="#FFFFFF", label="«ator»\nAdministrador"];
subgraph cluster_system { label="Sistema de gestão de clínica médica"; fontname="Arial"; fontsize=16; color="#A0C2AC"; style=rounded; margin=25;
Login [shape=ellipse, label="UC01\nAutenticar usuário"];
Patient [shape=ellipse, label="UC02\nManter paciente"];
Record [shape=ellipse, label="Criar prontuário\nna inclusão"];
Insurance [shape=ellipse, label="UC03\nVincular convênio"];
Schedule [shape=ellipse, label="UC04\nAgendar consulta"];
Availability [shape=ellipse, label="Validar vínculos e\ndisponibilidade"];
Status [shape=ellipse, label="UC05\nAtualizar situação\ndo agendamento"];
Attend [shape=ellipse, label="UC06\nRegistrar consulta"];
Active [shape=ellipse, label="Validar agendamento\nativo e autoria"];
History [shape=ellipse, label="UC07\nConsultar histórico"];
Allergy [shape=ellipse, label="UC08\nManter prontuário\ne alergias"];
Exam [shape=ellipse, label="UC09\nSolicitar exame"];
Result [shape=ellipse, label="UC10\nAcompanhar exames\ne resultados"];
Prescription [shape=ellipse, label="UC11\nPrescrever medicamentos"];
Procedure [shape=ellipse, label="UC12\nRegistrar procedimento"];
Charge [shape=ellipse, label="UC13\nEmitir cobrança"];
Payment [shape=ellipse, label="UC14\nRegistrar pagamento"];
Balance [shape=ellipse, label="Validar responsabilidade\ne saldo"];
Pending [shape=ellipse, label="UC15\nConsultar pendências"];
Reports [shape=ellipse, label="UC16\nGerar relatórios"];
Export [shape=ellipse, label="UC17\nExportar / imprimir"];
Catalog [shape=ellipse, label="UC18\nManter cadastros de apoio"];
Audit [shape=ellipse, label="UC19\nConsultar atividades"];
}
Reception -> Login [dir=none];
Doctor -> Login [dir=none];
Finance -> Login [dir=none];
Reception -> Patient [dir=none];
Reception -> Insurance [dir=none];
Reception -> Schedule [dir=none];
Reception -> Status [dir=none];
Doctor -> Attend [dir=none];
Doctor -> History [dir=none];
Doctor -> Allergy [dir=none];
Doctor -> Exam [dir=none];
Doctor -> Result [dir=none];
Doctor -> Prescription [dir=none];
Doctor -> Procedure [dir=none];
Finance -> Charge [dir=none];
Finance -> Payment [dir=none];
Finance -> Pending [dir=none];
Finance -> Reports [dir=none];
Finance -> Export [dir=none];
Admin -> Catalog [dir=none];
Admin -> Audit [dir=none];
Admin -> Reception [arrowhead=empty];
Admin -> Doctor [arrowhead=empty];
Admin -> Finance [arrowhead=empty];
Patient -> Record [style=dashed, label="«include»", arrowhead=vee];
Schedule -> Availability [style=dashed, label="«include»", arrowhead=vee];
Attend -> Active [style=dashed, label="«include»", arrowhead=vee];
Exam -> Attend [style=dashed, label="«extend»", arrowhead=vee];
Prescription -> Attend [style=dashed, label="«extend»", arrowhead=vee];
Procedure -> Attend [style=dashed, label="«extend»", arrowhead=vee];
Payment -> Balance [style=dashed, label="«include»", arrowhead=vee];
Export -> Reports [style=dashed, label="«extend»", arrowhead=vee];
}