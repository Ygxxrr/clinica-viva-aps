digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.5", nodesep="0.6", ranksep="1.0", splines=polyline, fontname="Arial", fontsize=22, label="Clínica Silva · Diagrama de classes", labelloc=t];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#719487", fontcolor="#47695A", arrowsize=0.7, dir=none];
subgraph cluster_1 { label="Atendimento"; color="#D5E6DC"; style="rounded"; fontcolor="#638C76"; fontsize=16; margin=25;
Appointment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Appointment</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+patient_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+doctor_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+specialty_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+unit_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+starts_at: DateTime</TD></TR><TR><TD ALIGN="LEFT">+status: String</TD></TR><TR><TD ALIGN="LEFT">+notes: Text [optional]</TD></TR></TABLE>>];
Consultation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Consultation</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+appointment_id: Integer [FK, unique]</TD></TR><TR><TD ALIGN="LEFT">+attended_at: DateTime</TD></TR><TR><TD ALIGN="LEFT">+complaint: Text</TD></TR><TR><TD ALIGN="LEFT">+notes: Text [optional]</TD></TR><TR><TD ALIGN="LEFT">+diagnosis: Text</TD></TR><TR><TD ALIGN="LEFT">+conduct: Text</TD></TR><TR><TD ALIGN="LEFT">/patient: Patient</TD></TR><TR><TD ALIGN="LEFT">/doctor: Professional</TD></TR></TABLE>>];
Exam [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Exam</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+description: Text [optional]</TD></TR><TR><TD ALIGN="LEFT">+kind: String</TD></TR></TABLE>>];
ExamRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>ExamRequest</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+consultation_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+exam_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+requested_at: Date</TD></TR><TR><TD ALIGN="LEFT">+status: String</TD></TR><TR><TD ALIGN="LEFT">+performed_at: Date [optional]</TD></TR><TR><TD ALIGN="LEFT">+result: Text [optional]</TD></TR><TR><TD ALIGN="LEFT">/patient: Patient</TD></TR></TABLE>>];
Medication [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Medication</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+active_ingredient: String</TD></TR><TR><TD ALIGN="LEFT">+manufacturer: String</TD></TR><TR><TD ALIGN="LEFT">+presentation: String</TD></TR></TABLE>>];
Prescription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Prescription</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+consultation_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+created_at: Date</TD></TR><TR><TD ALIGN="LEFT">+notes: Text [optional]</TD></TR></TABLE>>];
PrescriptionItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>PrescriptionItem</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+prescription_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+medication_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+quantity: Integer</TD></TR><TR><TD ALIGN="LEFT">+dose: String</TD></TR><TR><TD ALIGN="LEFT">+frequency: String</TD></TR><TR><TD ALIGN="LEFT">+duration: String</TD></TR><TR><TD ALIGN="LEFT">+notes: Text [optional]</TD></TR></TABLE>>];
Procedure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Procedure</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+description: Text [optional]</TD></TR><TR><TD ALIGN="LEFT">+standard_price: Decimal</TD></TR></TABLE>>];
PerformedProcedure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>PerformedProcedure</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+consultation_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+procedure_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+professional_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+performed_at: Date</TD></TR><TR><TD ALIGN="LEFT">+charged_price: Decimal</TD></TR></TABLE>>];
}
Appointment -> Consultation [ taillabel="1", headlabel="0..1", label="origina", labeldistance=2.0];
Consultation -> ExamRequest [ taillabel="1", headlabel="0..*", label="solicita", labeldistance=2.0];
Exam -> ExamRequest [ taillabel="1", headlabel="0..*", label="tipo de exame", labeldistance=2.0];
Consultation -> Prescription [ taillabel="1", headlabel="0..*", label="gera", labeldistance=2.0];
Prescription -> PrescriptionItem [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*", label="contém", labeldistance=2.0];
Medication -> PrescriptionItem [ taillabel="1", headlabel="0..*", label="é prescrito", labeldistance=2.0];
Consultation -> PerformedProcedure [ taillabel="1", headlabel="0..*", label="envolve", labeldistance=2.0];
Procedure -> PerformedProcedure [ taillabel="1", headlabel="0..*", label="catálogo", labeldistance=2.0];
}