digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.5", nodesep="0.6", ranksep="1.0", splines=polyline, fontname="Arial", fontsize=22, label="Clínica Silva · Diagrama de classes", labelloc=t];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#719487", fontcolor="#47695A", arrowsize=0.7, dir=none];
subgraph cluster_0 { label="Cadastros e estrutura"; color="#D5E6DC"; style="rounded"; fontcolor="#638C76"; fontsize=16; margin=25;
Patient [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Patient</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+cpf: String [unique]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+birth_date: Date</TD></TR><TR><TD ALIGN="LEFT">+sex: String</TD></TR><TR><TD ALIGN="LEFT">+phone: String</TD></TR><TR><TD ALIGN="LEFT">+email: String [optional]</TD></TR><TR><TD ALIGN="LEFT">+address: String</TD></TR></TABLE>>];
MedicalRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>MedicalRecord</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+patient_id: Integer [FK, unique]</TD></TR><TR><TD ALIGN="LEFT">+created_at: DateTime</TD></TR><TR><TD ALIGN="LEFT">+notes: Text [optional]</TD></TR></TABLE>>];
Allergy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Allergy</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String [unique]</TD></TR><TR><TD ALIGN="LEFT">+description: Text [optional]</TD></TR></TABLE>>];
PatientInsurance [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>PatientInsurance</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+patient_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+insurance_id: Integer [FK]</TD></TR><TR><TD ALIGN="LEFT">+card_number: String</TD></TR><TR><TD ALIGN="LEFT">+joined_at: Date</TD></TR><TR><TD ALIGN="LEFT">+status: String</TD></TR></TABLE>>];
Insurance [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Insurance</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+cnpj: String [unique]</TD></TR><TR><TD ALIGN="LEFT">+phone: String</TD></TR></TABLE>>];
Professional [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Professional</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+cpf: String [unique]</TD></TR><TR><TD ALIGN="LEFT">+phone: String</TD></TR><TR><TD ALIGN="LEFT">+email: String</TD></TR><TR><TD ALIGN="LEFT">+birth_date: Date</TD></TR><TR><TD ALIGN="LEFT">+registration: String</TD></TR><TR><TD ALIGN="LEFT">+kind: String</TD></TR><TR><TD ALIGN="LEFT">+crm: String [optional]</TD></TR><TR><TD ALIGN="LEFT">+crm_state: String [optional]</TD></TR></TABLE>>];
Specialty [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Specialty</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String [unique]</TD></TR><TR><TD ALIGN="LEFT">+description: Text [optional]</TD></TR></TABLE>>];
Unit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#76A58D" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#EAF4ED"><B>Unit</B></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#76A58D"></TD></TR><TR><TD ALIGN="LEFT">+id: Integer [PK]</TD></TR><TR><TD ALIGN="LEFT">+name: String</TD></TR><TR><TD ALIGN="LEFT">+address: String</TD></TR><TR><TD ALIGN="LEFT">+phone: String</TD></TR><TR><TD ALIGN="LEFT">+hours: String</TD></TR></TABLE>>];
}
Patient -> MedicalRecord [ taillabel="1", headlabel="1", label="possui", labeldistance=2.0];
Patient -> PatientInsurance [ taillabel="1", headlabel="0..*", label="possui", labeldistance=2.0];
Insurance -> PatientInsurance [ taillabel="1", headlabel="0..*", label="atende", labeldistance=2.0];
Patient -> Allergy [ taillabel="0..*", headlabel="0..*", label="patient_allergy", labeldistance=2.0];
Professional -> Specialty [ taillabel="0..*", headlabel="0..*", label="doctor_specialty", labeldistance=2.0];
Professional -> Unit [ taillabel="0..*", headlabel="1..*", label="professional_unit", labeldistance=2.0];
Unit -> Specialty [ taillabel="0..*", headlabel="1..*", label="unit_specialty", labeldistance=2.0];
}